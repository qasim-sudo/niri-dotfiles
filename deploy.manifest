# deploy.manifest
#
# Drives lib/deploy.sh. One entry per line:
#
#     <mode>   <source relative to the repo root>   <destination>
#
# Modes
#   link   symlink. Static config the desktop never writes. Cheapest to update:
#         edit in the repo, the change is live immediately.
#   copy   real copy. Use for anything a program rewrites at runtime. A
#         symlink there means the program writes THROUGH the link and edits
#         the repository, which is never what you want.
#   seed   copy only if the destination does not exist. For theme files
#         Noctalia generates on first run, so the first login already looks
#         themed but Noctalia owns the file from then on.
#   root   sudo install. For /etc files. Backed up as root first.
#
# Destination paths may use ~ and are expanded at deploy time. Source files may
# contain @TOKEN@ placeholders, substituted here:
#
#   @HOME@ @USER@ @WALLPAPER_DIR@ @ASSETS@ @DOTFILES@
#
# A file containing @TOKEN@ is always materialised as a real file, never
# symlinked, because a symlink cannot carry per-machine content.
#
# SAFETY
#   Every destination is backed up before the first write of a run, into
#   ~/.local/state/dotfiles/backups/<timestamp>/.
#   A destination is only overwritten if it is listed in deployed.json from a
#   previous run, does not exist, or --force was given. A pre-existing file
#   this repository has never managed is left untouched and reported.

# ---------------------------------------------------------------------------
# niri  (link: you are expected to edit these in the repo)
# NOTE: cfg/output.kdl is NOT here. It is generated per host by
# lib/hardware.sh and must never be committed.
# ---------------------------------------------------------------------------
link  config/niri/config.kdl                 ~/.config/niri/config.kdl
link  config/niri/noctalia.kdl               ~/.config/niri/noctalia.kdl
link  config/niri/cfg/input.kdl              ~/.config/niri/cfg/input.kdl
link  config/niri/cfg/layout.kdl             ~/.config/niri/cfg/layout.kdl
link  config/niri/cfg/appearance.kdl         ~/.config/niri/cfg/appearance.kdl
link  config/niri/cfg/animations.kdl         ~/.config/niri/cfg/animations.kdl
link  config/niri/cfg/binds.kdl              ~/.config/niri/cfg/binds.kdl
link  config/niri/cfg/environment.kdl        ~/.config/niri/cfg/environment.kdl
link  config/niri/cfg/gestures.kdl           ~/.config/niri/cfg/gestures.kdl

# ---------------------------------------------------------------------------
# Noctalia  (copy: Noctalia rewrites config.toml, and the runtime overlay in
# ~/.local/state is generated by lib/noctalia.sh)
# ---------------------------------------------------------------------------
copy  config/noctalia/config.toml             ~/.config/noctalia/config.toml

# ---------------------------------------------------------------------------
# Terminal  (link for the config; seed for the Noctalia-owned theme)
# ---------------------------------------------------------------------------
link  config/kitty/kitty.conf                 ~/.config/kitty/kitty.conf
seed  config/kitty/themes/noctalia.conf       ~/.config/kitty/themes/noctalia.conf
seed  config/kitty/current-theme.conf         ~/.config/kitty/current-theme.conf

# ---------------------------------------------------------------------------
# Shell
# ---------------------------------------------------------------------------
link  config/fish/config.fish                 ~/.config/fish/config.fish
link  config/starship/end4diagonal.toml       ~/.config/starship/end4diagonal.toml
link  config/fastfetch/config.jsonc           ~/.config/fastfetch/config.jsonc

# ---------------------------------------------------------------------------
# Launcher  (link for the config; seed for the Noctalia-owned theme)
# ---------------------------------------------------------------------------
link  config/fuzzel/fuzzel.ini                ~/.config/fuzzel/fuzzel.ini
seed  config/fuzzel/themes/noctalia           ~/.config/fuzzel/themes/noctalia

# ---------------------------------------------------------------------------
# Widget theming
# link for the settings (you edit these); seed for the Noctalia-owned colours
# ---------------------------------------------------------------------------
link  config/gtk-3.0/settings.ini             ~/.config/gtk-3.0/settings.ini
link  config/gtk-4.0/settings.ini             ~/.config/gtk-4.0/settings.ini
seed  config/qt5ct/noctalia/color.conf        ~/.config/qt5ct/noctalia/color.conf
seed  config/qt6ct/noctalia/color.conf        ~/.config/qt6ct/noctalia/color.conf
seed  config/papirus-folders/keep             ~/.config/papirus-folders/keep

# ---------------------------------------------------------------------------
# XDG
# mimeapps.list is NOT deployed by default — the installer registers Thunar
# additively with `xdg-mime default`, which preserves unrelated associations.
# See lib/xdg.sh and docs/FILE-MANAGER.md.
# ---------------------------------------------------------------------------
link  config/xdg/portals.conf                 ~/.config/xdg-portal/portals.conf

# ---------------------------------------------------------------------------
# /etc  (root deploy, backed up first)
# ---------------------------------------------------------------------------
root  etc/sddm.conf                           /etc/sddm.conf

# ---------------------------------------------------------------------------
# Local secrets. local.conf is read, never written. Only the .example is tracked.
# ---------------------------------------------------------------------------
seed  config/dotfiles/local.conf.example      ~/.config/dotfiles/local.conf.example
