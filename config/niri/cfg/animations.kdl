// Animations.
//
// The window open/close/resize transitions are custom GLSL shaders rather than
// stock presets. They produce the specific "settle into place" motion: a
// slight downward slide, a very small scale, and a gentle fade.
//
// `slowdown 1.5` is left in place from the tuning pass. Lower it to 1.0 (or
// remove the line) once the timings below feel right to you.

animations {
    slowdown 1.5

    // -----------------------------------------------------------------------
    window-open {
        duration-ms 260
        curve "cubic-bezier" 0.22 1.0 0.36 1.0

        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                // Slight top-to-bottom settle.
                float slide_px = (1.0 - p) * 60.0;
                float slide_geo = slide_px / max(size_geo.x, 1.0);

                // Very subtle scale-up into place.
                float scale = 0.985 + 0.015 * p;

                vec2 uv = coords_geo.xy;
                uv -= vec2(0.5, 0.5);
                uv /= scale;
                uv += vec2(0.5, 0.5);

                uv.y -= slide_geo;

                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                // Gentle fade-in.
                color *= p;

                return color;
            }
        "
    }

    // -----------------------------------------------------------------------
    window-close {
        duration-ms 180
        curve "cubic-bezier" 0.32 0.0 0.67 0.0

        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float inv = 1.0 - p;

                // Slight downward departure.
                float slide_px = p * 40.0;
                float slide_geo = slide_px / max(size_geo.x, 1.0);

                // Tiny scale-down on exit.
                float scale = 1.0 - 0.012 * p;

                vec2 uv = coords_geo.xy;
                uv -= vec2(0.5, 0.5);
                uv /= scale;
                uv += vec2(0.5, 0.5);

                uv.y -= slide_geo;

                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                color *= inv;
                return color;
            }
        "
    }

    // -----------------------------------------------------------------------
    window-resize {
        spring damping-ratio=1.0 stiffness=720 epsilon=0.0001

        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                // Show the next texture, with a very mild softening toward the
                // edges while in motion, so a resize feels less harsh.
                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);

                vec2 uv = coords_curr_geo.xy;
                float edge =
                    min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));

                float vignette = smoothstep(0.0, 0.06, edge);
                color.rgb *= mix(0.985, 1.0, vignette);

                return color;
            }
        "
    }

    // =======================================================================
    // Everything below uses springs, not shaders.
    // =======================================================================

    // Smooth and composed, no bounce.
    workspace-switch {
        spring damping-ratio=1.0 stiffness=760 epsilon=0.0001
    }

    // The main "camera glide" for scrollable movement.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=640 epsilon=0.0001
    }

    // Individual windows shift slightly tighter than the camera, so the layout
    // reads as organized rather than as one big moving image.
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // More refined than niri's default underdamped pop.
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=820 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=560 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 220
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }

    // Smooth and premium, not springy.
    overview-open-close {
        spring damping-ratio=1.0 stiffness=620 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=680 epsilon=0.001
    }
}
