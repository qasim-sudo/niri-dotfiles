# --- Wallpapers -----------------------------------------------------------
# Only the one wallpaper required to reproduce the current theme is tracked.
# Everything fetched or collected is ignored. See wallpapers/README.md.
wallpapers/favorites/*
!wallpapers/favorites/.gitkeep
wallpapers/*.png
wallpapers/*.jpg
wallpapers/*.jpeg
wallpapers/*.webp

# --- Screenshots and lock-screen shots -------------------------------------
*.png
!wallpapers/current/*.png
screenshots/
ScreenShot/

# --- Machine-generated config. NEVER COMMIT ------------------------------
# The comment-only placeholder for cfg/output.kdl IS committed, because
# config.kdl includes it unconditionally and niri has no optional include. Only
# the generated version, written to ~/.config/niri/cfg/output.kdl, is per-host.

# Noctalia's runtime overlay: per-monitor wallpaper assignment and per-display
# login boxes. Generated by lib/noctalia.sh.
config/noctalia/settings.toml

# --- Local secrets ---------------------------------------------------------
# Read by the installer, never written. Only the .example is tracked.
config/dotfiles/local.conf
local.conf
*.secret
*.key
!*.pub
id_rsa*
id_ed25519*
*.pem
.netrc
credentials
credentials.json
secrets.yaml
secrets.yml

# --- Personal application config. This repository reproduces a desktop, not a
#     workstation. Even if one of these is created by accident, never track it.
config/opencode/
config/spicetify/
config/nvim/
config/zed/
config/BraveSoftware/
config/Code/
config/VSCodium/
config/Google/
config/spotify/
config/spotify-player/
config/obsidian/
.spicetify/
.opencode/
.starship.db
.bash_history
.fish/
.local/state/opencode/
.local/share/opencode/
.wallhaven/

# Noctalia runtime state that must never be committed.
notification_history.json
clipboard/
usage_counts.json
recently_used.json
weather.json
location.json

# --- Installer state -------------------------------------------------------
backups/
last-install.log
latest-backup
deployed.json
SHA256SUMS
*.log

# --- Editor / OS noise -----------------------------------------------------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/
*.bak
*.orig
*.rej
.cache/
compile/
.direnv/
.envrc

# --- Temporary render targets --------------------------------------------
*.tmp
*.tmp.*
.dotfiles-*
